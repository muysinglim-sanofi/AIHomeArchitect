# ============================================================================
# AYDEN backend — LOCAL launch against PWA STAGING only.
#
# Copy to `.env.pwa-staging.local` (same directory) and fill in the values.
# That filename is already ignored by git (.gitignore:8 `.env.*` — verified).
#
# This file is a TEMPLATE: it must never hold a value. The real file is never
# printed, logged, diffed, committed, or bundled into the Web build.
#
# `backend/.env` is NOT used by this launch path and must not be loaded: it
# points at the PRODUCTION project and holds the production server key.
# ============================================================================

# ── Supabase: the ISOLATED PWA STAGING project ──────────────────────────────
# MUST be the staging project ref `eedcahzekpgxvvfxufbk`. The launcher refuses
# to start if this resolves to the production ref `vtxkciupyafukhdsgxgw`.
SUPABASE_URL=
# The staging SERVER key (service_role JWT or `sb_secret_*`). Server-side only —
# it never reaches Flutter Web, which holds the publishable key alone.
SUPABASE_SERVICE_ROLE_KEY=

# ── Provider ────────────────────────────────────────────────────────────────
# The same OpenAI key the canonical engine already uses. Server-side only.
OPENAI_API_KEY=

# ── Runtime flags — the canonical benched configuration ─────────────────────
# BIMODAL_ENABLED=1 is the validated engine config; launching without it serves
# a configuration that was never benched.
APP_ENV=staging
BIMODAL_ENABLED=1

# ── ABA PayWay — SANDBOX ONLY (Cambodia Web payments) ───────────────────────
# Issued by ABA's PayWay onboarding team for the SANDBOX merchant. Server-side
# only: the API key signs every request and MUST NEVER reach Flutter Web, a log
# line, or git. `payway.py` refuses to start a checkout if either is missing —
# there is no fallback to production credentials, by construction.
#
# Leaving these empty is a valid state: `/pwa/staging/entitlement` then reports
# `payment.configured = false` and the paywall says payments are not open.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=

# `sandbox` is the only accepted value in this build. `production` is refused by
# payway.py — productionization is a separate, reviewed phase.
PAYWAY_ENV=sandbox

# The PUBLIC https URL PayWay pushes the payment notification to. Must be
# reachable from the Internet and whitelisted in the PayWay merchant profile.
# 127.0.0.1 / localhost are REFUSED: PayWay cannot call them, and a callback
# that silently never arrives looks exactly like a payment that never happened.
# Leave EMPTY until a stable staging hostname exists — the adapter then runs in
# poll-only mode (Check Transaction drives the grant) instead of pretending.
PAYWAY_CALLBACK_URL=

# `required` (default) rejects a pushback whose X-PayWay-Hmac-Sha512 header is
# missing or wrong. `optional` accepts an unsigned pushback as a *trigger* only
# — it still grants nothing without Check Transaction. Never set `optional` in
# production.
PAYWAY_CALLBACK_SIGNATURE_MODE=required

# QR lifetime in MINUTES (PayWay: min 3). The order expires with it.
PAYWAY_QR_LIFETIME_MINUTES=30

# PayWay's own QR artwork template id, and the currency the Web sells in.
PAYWAY_QR_TEMPLATE=template3_color
PAYWAY_CURRENCY=USD
