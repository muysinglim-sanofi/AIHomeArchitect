<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<!-- Phase B — allow the app to be woken to process the FCM
		     "vision ready" push while backgrounded. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<!-- App uses only standard HTTPS encryption (exempt) → skips the
		     "Missing Compliance" prompt in TestFlight on every upload. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>AYDEN</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>ai_home_architect</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>NSMicrophoneUsageDescription</key>
		<string>AYDEN uses your microphone so you can describe your design vision by voice — speak naturally to your AI architect.</string>
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>AYDEN transcribes your spoken design ideas into the chat so you can express yourself naturally.</string>
		<key>NSCameraUsageDescription</key>
		<string>AYDEN uses your camera to capture the space you want to redesign.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>AYDEN needs access to your photos to import the space you want to redesign.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>AYDEN saves your redesigned visions to your photo library.</string>
		<!-- ───────────────────────────────────────────────────────────────────
	     Wave 5.17a — Identity Foundation.

	     CFBundleURLTypes registers two URL schemes:
	       1. The Google Sign-In OAuth callback. The actual value is the
	          REVERSED CLIENT ID of the iOS OAuth client from Google Cloud
	          Console (format: com.googleusercontent.apps.XXXXX). Replace
	          the placeholder below once Prerequisite C delivers it. With
	          the placeholder in place the build still succeeds ; the
	          Google sign-in just fails at runtime with "redirect URI
	          mismatch" until the real value lands.

	       2. The Supabase Auth deep-link callback. Used by
	          signInWithIdToken on iOS so the Supabase auth flow can
	          return control to the app. Same allowlist must contain
	          this URL in the Supabase dashboard (Prerequisite A).
	     ─────────────────────────────────────────────────────────────────── -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>aihomearchitect-auth</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>aihomearchitect</string>
				</array>
			</dict>
		</array>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
