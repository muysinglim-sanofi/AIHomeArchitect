OPENAI_API_KEY=sk-...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Wave 5.17a — Identity Foundation.
# Supabase JWT shared secret used to verify Authorization: Bearer <jwt>
# headers from the Flutter client. Distinct from SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY (those are signed BY this secret).
# Source : Supabase Dashboard → Project Settings → API → JWT Settings.
SUPABASE_JWT_SECRET=your-jwt-shared-secret-from-supabase-dashboard

# ── Sprint 1 — RevenueCat monetization ────────────────────────────────────────
# Shared secret for POST /webhooks/revenuecat (same value in the RC dashboard).
REVENUECAT_WEBHOOK_AUTH=your-strong-random-webhook-secret
# RevenueCat SERVER (secret) API key (starts "sk_"), used by POST /purchases/sync.
REVENUECAT_SECRET_API_KEY=sk_your_revenuecat_secret_api_key
