# AYDEN STUDIO PWA — staging environment TEMPLATE (Batch 3.0)
# Copy to a local, git-ignored file and fill with STAGING-ONLY values.
# NEVER commit real keys. NEVER put a service-role key here or in the client.
# These are passed as --dart-define at build time, e.g.:
#   flutter build web --dart-define=AYDEN_ENV=staging \
#     --dart-define=AYDEN_STAGING_SUPABASE_URL=... (etc.)

# mock | staging   (production is refused by this build)
AYDEN_ENV=mock

# Must be an isolated STAGING Supabase project URL. The boot guard requires it
# to contain "staging" (or localhost) and rejects any production denylist host.
AYDEN_STAGING_SUPABASE_URL=

# Staging ANON (public) key ONLY. A service-role key must never appear here.
AYDEN_STAGING_SUPABASE_ANON_KEY=

# Optional staging API facade base URL (Option A access model).
AYDEN_STAGING_API_BASE_URL=

# Guard for manual migrations. The app never reads this to run SQL.
AYDEN_ALLOW_STAGING_MIGRATIONS=false

# Optional: seed a demo library into a staging installation (dev review only).
AYDEN_STAGING_SEED_DEMO=false
