# ============================================================================
# AYDEN backend — LOCAL launch against PWA STAGING only.
#
# Copy to `.env.pwa-staging.local` (same directory) and fill in the values.
# That filename is already ignored by git (.gitignore:8 `.env.*` — verified).
#
# This file is a TEMPLATE: it must never hold a value. The real file is never
# printed, logged, diffed, committed, or bundled into the Web build.
#
# `backend/.env` is NOT used by this launch path and must not be loaded: it
# points at the PRODUCTION project and holds the production server key.
# ============================================================================

# ── Supabase: the ISOLATED PWA STAGING project ──────────────────────────────
# MUST be the staging project ref `eedcahzekpgxvvfxufbk`. The launcher refuses
# to start if this resolves to the production ref `vtxkciupyafukhdsgxgw`.
SUPABASE_URL=
# The staging SERVER key (service_role JWT or `sb_secret_*`). Server-side only —
# it never reaches Flutter Web, which holds the publishable key alone.
SUPABASE_SERVICE_ROLE_KEY=

# ── Provider ────────────────────────────────────────────────────────────────
# The same OpenAI key the canonical engine already uses. Server-side only.
OPENAI_API_KEY=

# ── Runtime flags — the canonical benched configuration ─────────────────────
# BIMODAL_ENABLED=1 is the validated engine config; launching without it serves
# a configuration that was never benched.
APP_ENV=staging
BIMODAL_ENABLED=1
