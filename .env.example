# Frontend environment template — copy to `.env` and fill in.
# `.env` is gitignored; this `.env.example` carries NO secrets (placeholders only).

# Backend API base URL (Android emulator uses 10.0.2.2 to reach host localhost).
API_BASE_URL=http://10.0.2.2:8000

# Supabase project (anon/publishable key — safe for clients, NOT the service key).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ── Sprint 1 — RevenueCat PUBLIC SDK keys ─────────────────────────────────────
# Platform PUBLIC keys from RevenueCat (Project → API keys). Empty values make
# Purchases.configure() degrade gracefully (paywall non-functional, no crash)
# when FeatureFlags.revenuecatGracefulDegradation is true.
REVENUECAT_PUBLIC_API_KEY_IOS=
REVENUECAT_PUBLIC_API_KEY_ANDROID=
