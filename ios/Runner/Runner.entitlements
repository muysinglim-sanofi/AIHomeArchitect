<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- FT2-B SPIKE entitlements (branch spike/ft2b-apple-identity-link ONLY).
	     Sign in with Apple is the ONLY capability the spike needs.

	     The production app's Push (aps-environment=production) is intentionally
	     REMOVED here so the spike's App ID (com.aydenstudio.app.ft2bspike) needs
	     NO Push capability — the spike never registers for notifications. No App
	     Groups / Keychain Access Groups / Associated Domains are declared either;
	     flutter_secure_storage works without a custom Keychain Access Group.

	     com.apple.developer.applesignin must still be enabled on the App ID in
	     the Apple Developer console and the App ID grouped under the primary
	     com.aydenstudio.app App ID (FT2-B1 conclusion). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
