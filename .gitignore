# AI Home Architect — root .gitignore
# Wave 4.9.2b — Backend MVP freeze. SECRET SAFETY: backend/.env holds
# OPENAI_API_KEY + SUPABASE_SERVICE_ROLE_KEY and must NEVER enter git history.

# ── Secrets / environment ─────────────────────────────────────────────
backend/.env
.env
.env.*
# …but DO commit the no-secret templates (placeholders only).
!.env.example
!**/.env.example
# The PWA staging launcher reads `backend/.env.pwa-staging.local`, which holds
# the staging server key and stays ignored by the `.env.*` rule above. Its
# TEMPLATE carries key names and no values, and has to be committed or the
# staging launch is not reproducible.
!backend/.env.pwa-staging.local.example

# Firebase iOS client config — belongs to the iOS app bundle (frontend),
# NOT the backend repo. Holds API_KEY / GOOGLE_APP_ID / GCM_SENDER_ID; keep it
# out of git history. Manage it on the iOS side or via Codemagic env.
GoogleService-Info.plist
**/GoogleService-Info.plist

# ── Python ────────────────────────────────────────────────────────────
**/__pycache__/
*.pyc
*.pyo
.venv/
backend/.venv/

# ── Flutter / Dart ────────────────────────────────────────────────────
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies

# ── Node ──────────────────────────────────────────────────────────────
node_modules/

# ── IDE ───────────────────────────────────────────────────────────────
.idea/
.vscode/

# ── Logs ──────────────────────────────────────────────────────────────
*.log

# Backend runtime logs (1GB+) — never commit
backend/logs/
