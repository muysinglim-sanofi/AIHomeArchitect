{
  "name": "AYDEN Studio",
  "image": "mcr.microsoft.com/devcontainers/python:3.10",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8000],
  "remoteEnv": {
    "BIMODAL_ENABLED": "1",
    "PATH": "${containerEnv:PATH}:/home/vscode/flutter/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  }
}
